{
  "name": "trustfirst-client-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade SaaS foundation for TrustFirst Client Portal.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @trustfirst/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "node scripts/ensure-rolldown-binding.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:binding": "node scripts/ensure-rolldown-binding.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "deploy:env": "node scripts/validate-env.mjs",
    "deploy:migration-check": "node scripts/migration-safety.mjs",
    "deploy:smoke": "node scripts/smoke-test.mjs",
    "intake:smoke": "node scripts/intake-smoke.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:manglam-demo": "node scripts/seed-manglam-demo.mjs",
    "mangalam:identity:apply": "node scripts/apply-mangalam-identity.mjs",
    "mangalam:cleanup:dry-run": "node scripts/mangalam-data-cleanup.mjs",
    "mangalam:cleanup:apply": "node scripts/mangalam-data-cleanup.mjs --apply",
    "reset:manglam-demo": "node scripts/seed-manglam-demo.mjs --reset",
    "demo:env": "node scripts/demo-env.mjs",
    "demo:db": "node scripts/demo-db.mjs",
    "demo:manglam": "node scripts/demo-manglam.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo:start": "node scripts/demo-start.mjs",
    "staging:env": "node scripts/staging-env.mjs",
    "staging:setup": "node scripts/staging-setup.mjs",
    "staging:start": "node scripts/staging-start.mjs",
    "staging:stop": "docker compose -f docker-compose.staging.yml down --remove-orphans",
    "vps:host-key": "node scripts/vps-host-key-verify.mjs",
    "vps:validate": "node scripts/vps-validate-access.mjs",
    "vps:bootstrap": "node scripts/vps-bootstrap.mjs",
    "vps:deploy": "node scripts/vps-deploy.mjs",
    "vps:smoke": "node scripts/vps-smoke.mjs",
    "vps:report": "node scripts/vps-report.mjs",
    "vps:mangalam:backup": "node scripts/vps-mangalam-backup.mjs",
    "vps:handover-release": "node scripts/vps-handover-release.mjs",
    "vps:mangalam:domain": "node scripts/vps-configure-mangalam-domain.mjs",
    "runtime:health": "node scripts/trustfirst-runtime-health.mjs",
    "db:generate": "npm run db:generate --workspace @trustfirst/database",
    "db:migrate": "npm run db:migrate --workspace @trustfirst/database",
    "db:studio": "npm run db:studio --workspace @trustfirst/database"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "@tailwindcss/postcss": {
      "postcss": "8.5.23"
    },
    "minimatch": "10.2.6"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
