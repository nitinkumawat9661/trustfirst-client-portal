    "@aws-sdk/s3-request-presigner": "3.899.0"
  },
  "devDependencies": {
    "@types/node": "20.17.57",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3",
    "@types/pg": "8.15.5"
  }
