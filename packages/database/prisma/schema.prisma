generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  SESSION_REFRESH
}

enum AuditAction {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL_DEVICES
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET_COMPLETED
  AUTH_PASSWORD_CHANGED
  AUTH_EMAIL_VERIFIED
  TENANT_SWITCHED
  PERMISSION_DENIED
}

enum ClientLifecycleStage {
  LEAD
  PROSPECT
  CLIENT
  ARCHIVED
}

enum ClientStatus {
  NEW
  ACTIVE
  ONBOARDING
  AT_RISK
  INACTIVE
  ARCHIVED
  SOFT_DELETED
}

enum ContactInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ClientActivityVerb {
  CREATED
  UPDATED
  COMMENTED
  UPLOADED
  APPROVED
  STATUS_CHANGED
  ARCHIVED
  DELETED
  RESTORED
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  normalizedEmail    String               @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole             @default(CLIENT)
  status             UserStatus           @default(ACTIVE)
  passwordHash       String?
  passwordChangedAt  DateTime?
  sessionVersion     Int                  @default(0)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  accounts           Account[]
  sessions           Session[]
  authTokens         AuthToken[]
  loginHistory       LoginHistory[]
  deviceSessions     DeviceSession[]
  tenantMemberships  TenantMembership[]
  tenantInvitations  TenantInvitation[]   @relation("TenantInvitationInviter")
  auditEvents        AuditEvent[]         @relation("AuditEventActor")
  ownedClients       ClientOrganization[] @relation("ClientOwner")
  managedClients     ClientOrganization[] @relation("ClientAccountManager")
  clientActivity     ClientActivityEvent[]
  clientNotes        ClientNote[]
  clientComments     ClientComment[]
  contactInvitations ClientContactInvitation[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([role])
  @@index([status])
  @@index([normalizedEmail])
  @@index([lockedUntil])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id              String         @id @default(cuid())
  sessionToken    String         @unique
  userId          String
  activeTenantId  String?
  rememberMe      Boolean        @default(false)
  rotatedAt       DateTime?
  revokedAt       DateTime?
  expires         DateTime
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant    Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  deviceSession   DeviceSession?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([activeTenantId])
  @@index([revokedAt])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  status          TenantStatus        @default(TRIAL)
  primaryDomain   String?
  branding        Json                @default("{}")
  settings        Json                @default("{}")
  memberships     TenantMembership[]
  invitations     TenantInvitation[]
  sessions        Session[]
  deviceSessions  DeviceSession[]
  loginHistory    LoginHistory[]
  rateLimitEvents RateLimitEvent[]
  auditEvents     AuditEvent[]
  clients         ClientOrganization[]
  clientContacts  ClientContact[]
  clientActivities ClientActivityEvent[]
  clientNotes     ClientNote[]
  clientComments  ClientComment[]
  clientTags      ClientTag[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([primaryDomain])
  @@index([createdAt])
}

model TenantMembership {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  status    TenantMemberStatus @default(ACTIVE)
  joinedAt  DateTime?
  invitedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([roleId])
}

model TenantInvitation {
  id              String                 @id @default(cuid())
  tenantId        String
  email           String
  normalizedEmail String
  roleId          String
  tokenHash       String                 @unique
  status          TenantInvitationStatus @default(PENDING)
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy       User                   @relation("TenantInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([normalizedEmail])
  @@index([expiresAt])
}

model Role {
  id              String             @id @default(cuid())
  key             String             @unique
  name            String
  description     String?
  system          Boolean            @default(false)
  permissions     RolePermission[]
  memberships     TenantMembership[]
  invitations     TenantInvitation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([system])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([usedAt])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String?
  tenantId   String?
  email      String
  success    Boolean
  failureCode String?
  ipAddress  String?
  userAgent  String?
  deviceHash String?
  occurredAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([email, occurredAt])
  @@index([success])
}

model DeviceSession {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String?
  sessionId    String?   @unique
  deviceHash   String
  label        String?
  ipAddress    String?
  userAgent    String?
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session      Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, deviceHash])
  @@index([userId, revokedAt])
  @@index([tenantId])
  @@index([deviceHash])
}

model RateLimitEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  key        String
  action     String
  count      Int      @default(1)
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, action])
  @@index([tenantId])
  @@index([resetAt])
}

model AuditEvent {
  id            String      @id @default(cuid())
  tenantId      String?
  actorId       String?
  action        AuditAction
  targetType    String?
  targetId      String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json        @default("{}")
  occurredAt    DateTime    @default(now())
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor         User?       @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
}

model ClientOrganization {
  id                 String                 @id @default(cuid())
  tenantId           String
  name               String
  legalName          String?
  slug               String
  lifecycleStage     ClientLifecycleStage   @default(LEAD)
  status             ClientStatus           @default(NEW)
  healthScore        Int                    @default(75)
  ownerId            String?
  accountManagerId   String?
  website            String?
  industry           String?
  source             String?
  metadata           Json                   @default("{}")
  customFields       Json                   @default("{}")
  archivedAt         DateTime?
  archivedById       String?
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User?                  @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  accountManager     User?                  @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  contacts           ClientContact[]
  contactInvitations ClientContactInvitation[]
  activities         ClientActivityEvent[]
  notes              ClientNote[]
  comments           ClientComment[]
  files              ClientFile[]
  approvals          ClientApproval[]
  tasks              ClientTask[]
  requirements       ClientRequirement[]
  projects           ClientProject[]
  tagAssignments     ClientTagAssignment[]
  customFieldValues  ClientCustomFieldValue[]

  @@unique([tenantId, slug])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, status])
  @@index([tenantId, accountManagerId])
  @@index([tenantId, ownerId])
  @@index([tenantId, deletedAt])
  @@index([name])
  @@index([createdAt])
}

model ClientContact {
  id             String                 @id @default(cuid())
  tenantId       String
  clientId       String
  name           String
  email          String
  normalizedEmail String
  phone          String?
  title          String?
  role           String?
  isPrimary      Boolean                @default(false)
  invitedAt      DateTime?
  lastActivityAt DateTime?
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         ClientOrganization     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, normalizedEmail])
  @@index([tenantId, normalizedEmail])
  @@index([clientId, isPrimary])
  @@index([lastActivityAt])
}

model ClientContactInvitation {
  id              String                  @id @default(cuid())
  tenantId        String
  clientId        String
  email           String
  normalizedEmail String
  role            String?
  tokenHash       String                  @unique
  status          ContactInvitationStatus @default(PENDING)
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  client          ClientOrganization      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy       User                    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, clientId, status])
  @@index([normalizedEmail])
  @@index([expiresAt])
}

model ClientActivityEvent {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  actorId     String?
  verb        ClientActivityVerb
  summary     String
  metadata    Json               @default("{}")
  occurredAt  DateTime           @default(now())
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor       User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model ClientNote {
  id         String             @id @default(cuid())
  tenantId   String
  clientId   String
  authorId   String?
  title      String?
  body       String             @db.Text
  visibility String             @default("internal")
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author     User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, createdAt])
  @@index([tenantId, authorId])
}

model ClientComment {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  parentId    String?
  authorId    String?
  body        String             @db.Text
  mentions    Json               @default("[]")
  attachments Json               @default("[]")
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent      ClientComment?     @relation("ClientCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ClientComment[]    @relation("ClientCommentThread")

  @@index([tenantId, clientId, createdAt])
  @@index([parentId])
  @@index([resolvedAt])
}

model ClientFile {
  id         String             @id @default(cuid())
  tenantId   String
  clientId   String
  name       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedById String?
  createdAt  DateTime           @default(now())
  client     ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, createdAt])
  @@index([storageKey])
}

model ClientApproval {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  title       String
  status      String             @default("pending")
  requestedById String?
  dueAt       DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientTask {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  title     String
  status    String             @default("open")
  dueAt     DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientRequirement {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  title     String
  status    String             @default("pending")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientProject {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  name      String
  status    String             @default("active")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientTag {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  color       String?
  createdAt   DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ClientTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClientTagAssignment {
  clientId String
  tagId    String
  client   ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      ClientTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientCustomFieldValue {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  fieldKey  String
  value     Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, fieldKey])
  @@index([tenantId, fieldKey])
}
