generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  SESSION_REFRESH
}

enum AuditAction {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL_DEVICES
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET_COMPLETED
  AUTH_PASSWORD_CHANGED
  AUTH_EMAIL_VERIFIED
  TENANT_SWITCHED
  PERMISSION_DENIED
  BILLING_INVOICE_CREATED
  BILLING_INVOICE_ISSUED
  BILLING_PAYMENT_RECORDED
}

enum ClientLifecycleStage {
  LEAD
  PROSPECT
  CLIENT
  ARCHIVED
}

enum ClientStatus {
  NEW
  ACTIVE
  ONBOARDING
  AT_RISK
  INACTIVE
  ARCHIVED
  SOFT_DELETED
}

enum ContactInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ClientActivityVerb {
  CREATED
  UPDATED
  COMMENTED
  UPLOADED
  APPROVED
  STATUS_CHANGED
  ARCHIVED
  DELETED
  RESTORED
}

enum RequirementStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequirementTimelineVerb {
  CREATED
  DRAFT_SAVED
  SUBMITTED
  REVIEW_REQUESTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  COMMENTED
  ATTACHED
  ASSIGNED
  VERSION_CREATED
  VERSION_RESTORED
}

enum ProjectLifecycleStatus {
  PLANNING
  ACTIVE
  BLOCKED
  REVIEW
  COMPLETED
  ARCHIVED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliverableReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ProjectTimelineVerb {
  CREATED
  UPDATED
  STATUS_CHANGED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  DELIVERABLE_CREATED
  DELIVERABLE_REVIEWED
  COMMENTED
  ATTACHED
  ASSIGNED
  COMPLETED
}

enum CommercialDocumentType {
  QUOTATION
  PROPOSAL
  ESTIMATE
  AGREEMENT
  WORK_ORDER
  RECEIPT
  INVOICE
}

enum CommercialDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum CommercialDocumentTimelineVerb {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
  VERSION_CREATED
  COMMENTED
  ATTACHED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  ARCHIVED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  PHONEPE
  UPI_QR
  MANUAL
}

enum BillingTimelineVerb {
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_ISSUED
  INVOICE_VOIDED
  INVOICE_ARCHIVED
  PAYMENT_RECORDED
  COMMENTED
  ATTACHED
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  normalizedEmail    String               @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole             @default(CLIENT)
  status             UserStatus           @default(ACTIVE)
  passwordHash       String?
  passwordChangedAt  DateTime?
  sessionVersion     Int                  @default(0)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  accounts           Account[]
  sessions           Session[]
  authTokens         AuthToken[]
  loginHistory       LoginHistory[]
  deviceSessions     DeviceSession[]
  tenantMemberships  TenantMembership[]
  tenantInvitations  TenantInvitation[]   @relation("TenantInvitationInviter")
  auditEvents        AuditEvent[]         @relation("AuditEventActor")
  ownedClients       ClientOrganization[] @relation("ClientOwner")
  managedClients     ClientOrganization[] @relation("ClientAccountManager")
  clientActivity     ClientActivityEvent[]
  clientNotes        ClientNote[]
  clientComments     ClientComment[]
  contactInvitations ClientContactInvitation[]
  ownedRequirements  Requirement[]        @relation("RequirementOwner")
  reviewedRequirements Requirement[]      @relation("RequirementReviewer")
  requirementTimeline RequirementTimelineEvent[]
  requirementComments RequirementComment[]
  managedProjects     Project[]            @relation("ProjectManager")
  ownedCommercialDocuments CommercialDocument[] @relation("CommercialDocumentOwner")
  approvedCommercialDocuments CommercialDocument[] @relation("CommercialDocumentApprover")
  rejectedCommercialDocuments CommercialDocument[] @relation("CommercialDocumentRejector")
  ownedInvoices     Invoice[]             @relation("InvoiceOwner")
  invoicePayments   PaymentRecord[]       @relation("PaymentRecorder")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([role])
  @@index([status])
  @@index([normalizedEmail])
  @@index([lockedUntil])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id              String         @id @default(cuid())
  sessionToken    String         @unique
  userId          String
  activeTenantId  String?
  rememberMe      Boolean        @default(false)
  rotatedAt       DateTime?
  revokedAt       DateTime?
  expires         DateTime
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant    Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  deviceSession   DeviceSession?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([activeTenantId])
  @@index([revokedAt])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  status          TenantStatus        @default(TRIAL)
  primaryDomain   String?
  branding        Json                @default("{}")
  settings        Json                @default("{}")
  memberships     TenantMembership[]
  invitations     TenantInvitation[]
  sessions        Session[]
  deviceSessions  DeviceSession[]
  loginHistory    LoginHistory[]
  rateLimitEvents RateLimitEvent[]
  auditEvents     AuditEvent[]
  clients         ClientOrganization[]
  clientContacts  ClientContact[]
  clientActivities ClientActivityEvent[]
  clientNotes     ClientNote[]
  clientComments  ClientComment[]
  clientTags      ClientTag[]
  requirements    Requirement[]
  requirementTimelineEvents RequirementTimelineEvent[]
  projects        Project[]
  commercialDocuments CommercialDocument[]
  commercialDocumentTimelineEvents CommercialDocumentTimelineEvent[]
  billingProfiles BillingProfile[]
  invoices        Invoice[]
  payments        PaymentRecord[]
  billingTimelineEvents BillingTimelineEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([primaryDomain])
  @@index([createdAt])
}

model TenantMembership {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  status    TenantMemberStatus @default(ACTIVE)
  joinedAt  DateTime?
  invitedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([roleId])
}

model TenantInvitation {
  id              String                 @id @default(cuid())
  tenantId        String
  email           String
  normalizedEmail String
  roleId          String
  tokenHash       String                 @unique
  status          TenantInvitationStatus @default(PENDING)
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy       User                   @relation("TenantInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([normalizedEmail])
  @@index([expiresAt])
}

model Role {
  id              String             @id @default(cuid())
  key             String             @unique
  name            String
  description     String?
  system          Boolean            @default(false)
  permissions     RolePermission[]
  memberships     TenantMembership[]
  invitations     TenantInvitation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([system])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([usedAt])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String?
  tenantId   String?
  email      String
  success    Boolean
  failureCode String?
  ipAddress  String?
  userAgent  String?
  deviceHash String?
  occurredAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([email, occurredAt])
  @@index([success])
}

model DeviceSession {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String?
  sessionId    String?   @unique
  deviceHash   String
  label        String?
  ipAddress    String?
  userAgent    String?
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session      Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, deviceHash])
  @@index([userId, revokedAt])
  @@index([tenantId])
  @@index([deviceHash])
}

model RateLimitEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  key        String
  action     String
  count      Int      @default(1)
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, action])
  @@index([tenantId])
  @@index([resetAt])
}

model AuditEvent {
  id            String      @id @default(cuid())
  tenantId      String?
  actorId       String?
  action        AuditAction
  targetType    String?
  targetId      String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json        @default("{}")
  occurredAt    DateTime    @default(now())
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor         User?       @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
}

model ClientOrganization {
  id                 String                 @id @default(cuid())
  tenantId           String
  name               String
  legalName          String?
  slug               String
  lifecycleStage     ClientLifecycleStage   @default(LEAD)
  status             ClientStatus           @default(NEW)
  healthScore        Int                    @default(75)
  ownerId            String?
  accountManagerId   String?
  website            String?
  industry           String?
  source             String?
  metadata           Json                   @default("{}")
  customFields       Json                   @default("{}")
  archivedAt         DateTime?
  archivedById       String?
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User?                  @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  accountManager     User?                  @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  contacts           ClientContact[]
  contactInvitations ClientContactInvitation[]
  activities         ClientActivityEvent[]
  notes              ClientNote[]
  comments           ClientComment[]
  files              ClientFile[]
  approvals          ClientApproval[]
  tasks              ClientTask[]
  requirements       ClientRequirement[]
  projects           ClientProject[]
  tagAssignments     ClientTagAssignment[]
  customFieldValues  ClientCustomFieldValue[]
  requirementRecords Requirement[]
  projectRecords     Project[]
  commercialDocuments CommercialDocument[]
  billingProfiles BillingProfile[]
  invoices        Invoice[]

  @@unique([tenantId, slug])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, status])
  @@index([tenantId, accountManagerId])
  @@index([tenantId, ownerId])
  @@index([tenantId, deletedAt])
  @@index([name])
  @@index([createdAt])
}

model ClientContact {
  id             String                 @id @default(cuid())
  tenantId       String
  clientId       String
  name           String
  email          String
  normalizedEmail String
  phone          String?
  title          String?
  role           String?
  isPrimary      Boolean                @default(false)
  invitedAt      DateTime?
  lastActivityAt DateTime?
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         ClientOrganization     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, normalizedEmail])
  @@index([tenantId, normalizedEmail])
  @@index([clientId, isPrimary])
  @@index([lastActivityAt])
}

model ClientContactInvitation {
  id              String                  @id @default(cuid())
  tenantId        String
  clientId        String
  email           String
  normalizedEmail String
  role            String?
  tokenHash       String                  @unique
  status          ContactInvitationStatus @default(PENDING)
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  client          ClientOrganization      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy       User                    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, clientId, status])
  @@index([normalizedEmail])
  @@index([expiresAt])
}

model ClientActivityEvent {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  actorId     String?
  verb        ClientActivityVerb
  summary     String
  metadata    Json               @default("{}")
  occurredAt  DateTime           @default(now())
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor       User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model ClientNote {
  id         String             @id @default(cuid())
  tenantId   String
  clientId   String
  authorId   String?
  title      String?
  body       String             @db.Text
  visibility String             @default("internal")
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author     User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, createdAt])
  @@index([tenantId, authorId])
}

model ClientComment {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  parentId    String?
  authorId    String?
  body        String             @db.Text
  mentions    Json               @default("[]")
  attachments Json               @default("[]")
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent      ClientComment?     @relation("ClientCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ClientComment[]    @relation("ClientCommentThread")

  @@index([tenantId, clientId, createdAt])
  @@index([parentId])
  @@index([resolvedAt])
}

model ClientFile {
  id         String             @id @default(cuid())
  tenantId   String
  clientId   String
  name       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedById String?
  createdAt  DateTime           @default(now())
  client     ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, createdAt])
  @@index([storageKey])
}

model ClientApproval {
  id          String             @id @default(cuid())
  tenantId    String
  clientId    String
  title       String
  status      String             @default("pending")
  requestedById String?
  dueAt       DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  client      ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientTask {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  title     String
  status    String             @default("open")
  dueAt     DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientRequirement {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  title     String
  status    String             @default("pending")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientProject {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  name      String
  status    String             @default("active")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, status])
}

model ClientTag {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  color       String?
  createdAt   DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ClientTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClientTagAssignment {
  clientId String
  tagId    String
  client   ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      ClientTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientCustomFieldValue {
  id        String             @id @default(cuid())
  tenantId  String
  clientId  String
  fieldKey  String
  value     Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, fieldKey])
  @@index([tenantId, fieldKey])
}

model Requirement {
  id              String                 @id @default(cuid())
  tenantId        String
  clientId        String?
  title           String
  summary         String?
  status          RequirementStatus      @default(DRAFT)
  priority        RequirementPriority    @default(MEDIUM)
  ownerId         String?
  reviewerId      String?
  dueAt           DateTime?
  currentVersion  Int                    @default(1)
  formSchema      Json                   @default("{}")
  draftData       Json                   @default("{}")
  submittedData   Json?
  metadata        Json                   @default("{}")
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          ClientOrganization?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner           User?                  @relation("RequirementOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewer        User?                  @relation("RequirementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  drafts          RequirementDraft[]
  versions        RequirementVersion[]
  timeline        RequirementTimelineEvent[]
  attachments     RequirementAttachment[]
  comments        RequirementComment[]
  notifications   RequirementNotification[]
  commercialDocuments CommercialDocument[]
  invoices        Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, ownerId])
  @@index([tenantId, reviewerId])
  @@index([tenantId, updatedAt])
  @@index([dueAt])
}

model RequirementDraft {
  id            String      @id @default(cuid())
  tenantId      String
  requirementId String
  authorId      String?
  data          Json
  source        String      @default("manual")
  revision      Int
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, revision])
  @@index([tenantId, requirementId, createdAt])
}

model RequirementVersion {
  id            String      @id @default(cuid())
  tenantId      String
  requirementId String
  version       Int
  data          Json
  summary       String?
  createdById   String?
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, version])
  @@index([tenantId, requirementId, version])
}

model RequirementTimelineEvent {
  id            String                  @id @default(cuid())
  tenantId      String
  requirementId String
  actorId       String?
  verb          RequirementTimelineVerb
  summary       String
  metadata      Json                    @default("{}")
  occurredAt    DateTime                @default(now())
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement   Requirement             @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  actor         User?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, requirementId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model RequirementAttachment {
  id            String      @id @default(cuid())
  tenantId      String
  requirementId String
  version       Int?
  name          String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  uploadedById  String?
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([tenantId, requirementId])
  @@index([tenantId, version])
  @@index([storageKey])
}

model RequirementComment {
  id            String               @id @default(cuid())
  tenantId      String
  requirementId String
  parentId      String?
  authorId      String?
  body          String               @db.Text
  mentions      Json                 @default("[]")
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  requirement   Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  author        User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent        RequirementComment?  @relation("RequirementCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       RequirementComment[] @relation("RequirementCommentThread")

  @@index([tenantId, requirementId, createdAt])
  @@index([parentId])
  @@index([resolvedAt])
}

model RequirementNotification {
  id            String      @id @default(cuid())
  tenantId      String
  requirementId String
  recipientId   String?
  type          String
  payload       Json        @default("{}")
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, requirementId, createdAt])
}

model Project {
  id              String                 @id @default(cuid())
  tenantId        String
  clientId        String?
  name            String
  slug            String
  description     String?                @db.Text
  status          ProjectLifecycleStatus @default(PLANNING)
  priority        ProjectPriority        @default(MEDIUM)
  managerId       String?
  startDate       DateTime?
  targetDate      DateTime?
  completedAt     DateTime?
  archivedAt      DateTime?
  progress        Int                    @default(0)
  calendar        Json                   @default("{}")
  gantt           Json                   @default("{}")
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          ClientOrganization?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager         User?                  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  milestones      ProjectMilestone[]
  tasks           ProjectTask[]
  deliverables    ProjectDeliverable[]
  attachments     ProjectAttachment[]
  timeline        ProjectTimelineEvent[]
  notifications   ProjectNotification[]
  labels          ProjectLabel[]
  commercialDocuments CommercialDocument[]
  invoices        Invoice[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, managerId])
  @@index([tenantId, updatedAt])
  @@index([targetDate])
}

model CommercialDocument {
  id                  String                   @id @default(cuid())
  tenantId            String
  documentNumber      String
  type                CommercialDocumentType
  status              CommercialDocumentStatus @default(DRAFT)
  title               String
  summary             String?                  @db.Text
  clientId            String?
  projectId           String?
  requirementId       String?
  ownerId             String?
  approvedById        String?
  rejectedById        String?
  templateKey         String
  branding            Json                     @default("{}")
  content             Json                     @default("{}")
  metadata            Json                     @default("{}")
  currentVersion      Int                      @default(1)
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              ClientOrganization?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project             Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requirement         Requirement?             @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  owner               User?                    @relation("CommercialDocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy          User?                    @relation("CommercialDocumentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy          User?                    @relation("CommercialDocumentRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  versions            CommercialDocumentVersion[]
  timeline            CommercialDocumentTimelineEvent[]
  comments            CommercialDocumentComment[]
  attachments         CommercialDocumentAttachment[]
  invoices            Invoice[]
  receiptPayments     PaymentRecord[] @relation("PaymentReceiptDocument")

  @@unique([tenantId, documentNumber])
  @@index([tenantId, type, status])
  @@index([tenantId, clientId])
  @@index([tenantId, projectId])
  @@index([tenantId, requirementId])
  @@index([tenantId, ownerId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, archivedAt])
}

model CommercialDocumentVersion {
  id          String             @id @default(cuid())
  tenantId    String
  documentId  String
  version     Int
  content     Json
  summary     String?
  createdById String?
  createdAt   DateTime           @default(now())
  document    CommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId, documentId, version])
}

model CommercialDocumentTimelineEvent {
  id          String                         @id @default(cuid())
  tenantId    String
  documentId  String
  actorId     String?
  verb        CommercialDocumentTimelineVerb
  summary     String
  metadata    Json                           @default("{}")
  occurredAt  DateTime                       @default(now())
  tenant      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document    CommercialDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model CommercialDocumentComment {
  id           String                      @id @default(cuid())
  tenantId     String
  documentId   String
  parentId     String?
  authorId     String?
  body         String                      @db.Text
  mentions     Json                        @default("[]")
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  document     CommercialDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent       CommercialDocumentComment?  @relation("CommercialDocumentCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      CommercialDocumentComment[] @relation("CommercialDocumentCommentThread")

  @@index([tenantId, documentId, createdAt])
  @@index([parentId])
  @@index([resolvedAt])
}

model CommercialDocumentAttachment {
  id           String             @id @default(cuid())
  tenantId     String
  documentId   String
  version      Int?
  name         String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime           @default(now())
  document     CommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, version])
  @@index([storageKey])
}

model BillingProfile {
  id            String             @id @default(cuid())
  tenantId      String
  clientId      String
  legalName     String
  billingEmail  String?
  taxIdentifier String?
  address       Json               @default("{}")
  currency      String             @default("INR")
  paymentTerms  Json               @default("{}")
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        ClientOrganization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId, billingEmail])
}

model Invoice {
  id                   String              @id @default(cuid())
  tenantId             String
  invoiceNumber        String
  status               InvoiceStatus       @default(DRAFT)
  title                String
  summary              String?             @db.Text
  clientId             String?
  projectId            String?
  requirementId        String?
  commercialDocumentId String?
  ownerId              String?
  currency             String              @default("INR")
  totalAmountCents     Int
  paidAmountCents      Int                 @default(0)
  dueAt                DateTime?
  issuedAt             DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  archivedAt           DateTime?
  paymentTerms         Json                @default("{}")
  branding             Json                @default("{}")
  lineItems            Json                @default("[]")
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client               ClientOrganization? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requirement          Requirement?        @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  commercialDocument   CommercialDocument? @relation(fields: [commercialDocumentId], references: [id], onDelete: SetNull)
  owner                User?               @relation("InvoiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  payments             PaymentRecord[]
  timeline             BillingTimelineEvent[]
  comments             InvoiceComment[]
  attachments          InvoiceAttachment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, projectId])
  @@index([tenantId, requirementId])
  @@index([tenantId, ownerId])
  @@index([tenantId, dueAt])
  @@index([tenantId, updatedAt])
}

model PaymentRecord {
  id                String              @id @default(cuid())
  tenantId          String
  invoiceId         String
  amountCents       Int
  mode              PaymentMode
  provider          PaymentProvider     @default(MANUAL)
  reference         String?
  receiptDocumentId String?
  recordedById      String?
  receivedAt        DateTime
  notes             String?             @db.Text
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptDocument   CommercialDocument? @relation("PaymentReceiptDocument", fields: [receiptDocumentId], references: [id], onDelete: SetNull)
  recordedBy        User?               @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId, receivedAt])
  @@index([tenantId, provider])
  @@index([tenantId, mode])
  @@index([receiptDocumentId])
}

model BillingTimelineEvent {
  id         String              @id @default(cuid())
  tenantId   String
  invoiceId  String
  actorId    String?
  verb       BillingTimelineVerb
  summary    String
  metadata   Json                @default("{}")
  occurredAt DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model InvoiceComment {
  id           String           @id @default(cuid())
  tenantId     String
  invoiceId    String
  parentId     String?
  authorId     String?
  body         String           @db.Text
  mentions     Json             @default("[]")
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  parent       InvoiceComment?  @relation("InvoiceCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      InvoiceComment[] @relation("InvoiceCommentThread")

  @@index([tenantId, invoiceId, createdAt])
  @@index([parentId])
  @@index([resolvedAt])
}

model InvoiceAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  invoiceId    String
  name         String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId, createdAt])
  @@index([storageKey])
}

model ProjectMilestone {
  id             String             @id @default(cuid())
  tenantId       String
  projectId      String
  name           String
  description    String?
  status         String             @default("open")
  dueAt          DateTime?
  completedAt    DateTime?
  progress       Int                @default(0)
  dependencies   Json               @default("[]")
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          ProjectTask[]
  deliverables   ProjectDeliverable[]

  @@index([tenantId, projectId, dueAt])
  @@index([tenantId, status])
}

model ProjectTask {
  id             String            @id @default(cuid())
  tenantId       String
  projectId      String
  milestoneId    String?
  parentId       String?
  title          String
  description    String?           @db.Text
  status         ProjectTaskStatus  @default(TODO)
  priority       ProjectPriority    @default(MEDIUM)
  assigneeId     String?
  dueAt          DateTime?
  estimatedHours Float?
  actualHours    Float?
  checklist      Json              @default("[]")
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent         ProjectTask?      @relation("ProjectTaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       ProjectTask[]     @relation("ProjectTaskHierarchy")
  labels         ProjectTaskLabel[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueAt])
  @@index([parentId])
}

model ProjectLabel {
  id          String             @id @default(cuid())
  tenantId    String
  projectId   String
  name        String
  color       String?
  createdAt   DateTime           @default(now())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabels  ProjectTaskLabel[]

  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId])
}

model ProjectTaskLabel {
  taskId  String
  labelId String
  task    ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model ProjectDeliverable {
  id                   String                  @id @default(cuid())
  tenantId             String
  projectId            String
  milestoneId          String?
  title                String
  description          String?                 @db.Text
  requirementId        String?
  requirementVersion   Int?
  reviewStatus         DeliverableReviewStatus @default(DRAFT)
  clientApprovalStatus String                   @default("pending")
  dueAt                DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone            ProjectMilestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  attachments          ProjectAttachment[]

  @@index([tenantId, projectId, reviewStatus])
  @@index([tenantId, requirementId, requirementVersion])
  @@index([tenantId, dueAt])
}

model ProjectAttachment {
  id            String              @id @default(cuid())
  tenantId      String
  projectId     String
  deliverableId String?
  name          String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  uploadedById  String?
  createdAt     DateTime            @default(now())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable   ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, deliverableId])
  @@index([storageKey])
}

model ProjectTimelineEvent {
  id         String              @id @default(cuid())
  tenantId   String
  projectId  String
  actorId    String?
  verb       ProjectTimelineVerb
  summary    String
  metadata   Json                @default("{}")
  occurredAt DateTime            @default(now())
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, occurredAt])
  @@index([tenantId, verb])
  @@index([actorId])
}

model ProjectNotification {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  recipientId String?
  type      String
  payload   Json     @default("{}")
  readAt    DateTime?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, projectId, createdAt])
}
